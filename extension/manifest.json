{
  "manifest_version": 3,
  "name": "LinkedIn Bridge for n8n",
  "version": "1.0.0",
  "description": "Connect your logged-in LinkedIn session to n8n. Runs browser actions on a schedule you control (cron).",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "sidepanel.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "LinkedIn Bridge for n8n"
  },
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "cookies",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
